# ─── Product data source ──────────────────────────────────────────────────────
# Etsy denied our API v3 application, so the storefront reads from a local catalog
# (src/data/catalog.json) with the public Etsy RSS feed layered on top for new
# arrivals. Neither needs credentials, so this section is optional.
#
#   auto (default)  Use the Etsy API when ETSY_API_KEY is set, otherwise the catalog.
#   catalog         Force the local catalog. Useful to test the fallback path.
#   etsy            Force the Etsy API. Fails without a key.
# SHOP_DATA_SOURCE=auto
#
# Set to 1 to skip the live RSS overlay and serve only what's in catalog.json.
# Handy offline, in CI, or to get fully reproducible builds.
# SHOP_DISABLE_RSS=1

# ─── Etsy API (currently unavailable) ─────────────────────────────────────────
# Only needed if Etsy approves an API application later. Setting it flips the
# storefront back to the live API with no code changes.
# Get it from: https://www.etsy.com/developers/your-apps
# ETSY_API_KEY=your_etsy_api_key_here

# ─── Site ─────────────────────────────────────────────────────────────────────
# Your deployed site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://designthathits.com

# ─── Contact form ─────────────────────────────────────────────────────────────
# Without RESEND_API_KEY the form returns 503 and tells the visitor to use the
# mailto or Etsy link instead. It never reports a send that did not happen.
#
# Get a key at https://resend.com and verify designthathits.com there first:
# CONTACT_FROM must be on a domain Resend has verified, or every send is rejected.
# The visitor's own address goes in reply_to, which is what makes replying work.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# Where messages land. Defaults to hello@designthathits.com.
# CONTACT_EMAIL=hello@designthathits.com
#
# The From header. Defaults to "Design That Hits <hello@designthathits.com>".
# CONTACT_FROM=Design That Hits <hello@designthathits.com>
